---
interface Props { text: string }
const { text } = Astro.props;
---
<div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius);padding:1rem 1.25rem;margin:1.5rem 0;">
  <p style="font-weight:700;color:var(--color-primary);margin:0 0 0.35rem;text-transform:uppercase;font-size:0.75rem;letter-spacing:0.05em;">Disclosure</p>
  <p style="margin:0;color:var(--color-muted);font-size:0.95rem;">{text}</p>
</div>
