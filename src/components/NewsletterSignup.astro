---
---
<div style="max-width:600px;margin:0 auto;text-align:center;">
  <h2 style="margin-bottom:0.5rem;">Research Briefing</h2>
  <p style="color:var(--color-muted);margin-bottom:1.5rem;">Subscribe to receive our latest research and analysis directly.</p>
  <form id="newsletter-form" style="display:flex;gap:0.75rem;flex-wrap:wrap;justify-content:center;">
    <input type="email" name="email" placeholder="Your email address" required style="flex:1;min-width:250px;padding:0.75rem 1rem;border:1px solid var(--color-border);border-radius:var(--radius);font-size:1rem;" />
    <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;" aria-hidden="true" />
    <button type="submit" class="btn">Subscribe</button>
  </form>
  <p id="newsletter-msg" style="margin-top:0.75rem;font-size:0.9rem;"></p>
</div>
<script>
document.getElementById('newsletter-form')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = e.target;
  const email = form.email.value;
  const msg = document.getElementById('newsletter-msg');
  try {
    const res = await fetch('https://research-api.n311311.workers.dev/api/form/newsletter', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ site: 'calderstoneresearch.com', name: 'Newsletter Subscriber', email, message: 'Subscribe to Research Briefing', website: '' }),
    });
    msg.textContent = 'Thank you! You\'re subscribed.';
    msg.style.color = 'var(--color-success)';
    form.reset();
  } catch { msg.textContent = 'Something went wrong. Please try again.'; }
});
</script>
