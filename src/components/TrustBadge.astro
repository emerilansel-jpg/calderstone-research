---
interface Props { icon: string; label: string }
const { icon, label } = Astro.props;
---
<span style="display:inline-flex;align-items:center;gap:0.35rem;background:rgba(255,255,255,0.12);padding:0.35rem 0.7rem;border-radius:4px;font-size:0.75rem;font-weight:500;">
  <span>{icon}</span> {label}
</span>
