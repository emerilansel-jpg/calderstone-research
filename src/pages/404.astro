---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — Page Not Found">
  <section class="section" style="text-align:center;padding:8rem 0;">
    <div class="container">
      <h1 style="font-size:4rem;color:var(--color-accent);">404</h1>
      <p style="font-size:1.25rem;color:var(--color-muted);margin-top:1rem;">The page you're looking for doesn't exist.</p>
      <a href="/" class="btn" style="margin-top:2rem;">Return Home</a>
    </div>
  </section>
</BaseLayout>
