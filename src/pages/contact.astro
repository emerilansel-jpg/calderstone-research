---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Contact — Calderstone Research">
  <section class="section">
    <div class="container" style="max-width:800px;">
      <h1 style="margin-bottom:1.5rem;">Contact</h1>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:2rem;margin-top:1.5rem;"><div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius);padding:1.5rem;"><h3 style="margin-top:0;">Research Desk</h3><p><a href="mailto:research@calderstoneresearch.com">research@calderstoneresearch.com</a></p><p>For research inquiries and report requests.</p></div><div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius);padding:1.5rem;"><h3 style="margin-top:0;">Editorial</h3><p><a href="mailto:editorial@calderstoneresearch.com">editorial@calderstoneresearch.com</a></p><p>For editorial inquiries and submissions.</p></div><div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius);padding:1.5rem;"><h3 style="margin-top:0;">Corrections</h3><p><a href="mailto:corrections@calderstoneresearch.com">corrections@calderstoneresearch.com</a></p><p>Found an error? We welcome corrections.</p></div></div>
    </div>
  </section>
</BaseLayout>
