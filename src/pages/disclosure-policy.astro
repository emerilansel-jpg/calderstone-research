---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Disclosure Policy" description="Disclosure Policy — Calderstone Research">
  <section class="section">
    <div class="container" style="max-width:800px;">
      <h1 style="margin-bottom:1.5rem;">Disclosure Policy</h1>
      <p>Full transparency is fundamental to our research practice. This policy outlines how we disclose commercial relationships, funding sources, and potential conflicts of interest.</p><h2>What We Disclose</h2><ul><li>Any commercial relationship with evaluated entities</li><li>Funding sources for research projects</li><li>Analyst financial positions in covered companies</li><li>Access or data provided by evaluated entities</li></ul>
    </div>
  </section>
</BaseLayout>
