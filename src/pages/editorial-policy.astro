---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Editorial Policy" description="Editorial Policy — Calderstone Research">
  <section class="section">
    <div class="container" style="max-width:800px;">
      <h1 style="margin-bottom:1.5rem;">Editorial Policy</h1>
      <p>Calderstone Research maintains strict editorial independence. Our editorial policies ensure that research output is never influenced by commercial relationships, sponsorships, or external pressure.</p><h2>Core Principles</h2><ul><li>Research criteria are fixed before evaluation begins</li><li>No pay-to-rank or sponsored placement</li><li>All commercial relationships are disclosed</li><li>Corrections are welcomed and published transparently</li></ul>
    </div>
  </section>
</BaseLayout>
