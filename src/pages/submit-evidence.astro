---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Submit Evidence" description="Submit Evidence — Calderstone Research">
  <section class="section">
    <div class="container" style="max-width:800px;">
      <h1 style="margin-bottom:1.5rem;">Submit Evidence</h1>
      <p>We welcome evidence submissions that can improve the accuracy and completeness of our research.</p><p>To submit evidence or request a correction, email <a href="mailto:corrections@calderstoneresearch.com">corrections@calderstoneresearch.com</a> with:</p><ul><li>The specific report or claim in question</li><li>Your supporting evidence (documentation, data, or references)</li><li>Your contact information for follow-up</li></ul>
    </div>
  </section>
</BaseLayout>
